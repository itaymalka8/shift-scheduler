// Prisma schema for Goalx Manager
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  name          String?
  createdAt     DateTime  @default(now())
  accounts      Account[]
  sessions      Session[]
  team          Team?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Team {
  id                  String         @id @default(cuid())
  name                String
  crestShape          String?
  crestPattern        String?
  crestIcon           String?
  crestColor          String?
  crestSecondaryColor String?
  crestBorderColor    String?
  crestImageUrl       String?
  countryCode         String?
  stadiumName         String?
  stadiumStyle        String?
  stadiumCapacity     Int            @default(100)
  crowdStyle          String?
  isBot               Boolean        @default(false)
  formation           String?
  tacticStyle         String?
  createdAt           DateTime       @default(now())
  user                User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              String?        @unique
  divisionMemberships DivisionTeam[]
  homeFixtures        Fixture[]      @relation("HomeFixtures")
  awayFixtures        Fixture[]      @relation("AwayFixtures")
  players             Player[]
  lineupSlots         LineupSlot[]
  matchEvents         MatchEvent[]
}

model Player {
  id           String      @id @default(cuid())
  teamId       String
  team         Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name         String
  position     String
  age          Int
  rating       Int
  jerseyNumber Int
  createdAt    DateTime    @default(now())
  lineupSlot   LineupSlot?
}

// A player's spot in their team's current starting XI, positioned freely on
// the pitch (x/y are 0-100 percentages). Only 11 players have one at a time;
// everyone else on the roster is on the bench.
model LineupSlot {
  id       String @id @default(cuid())
  teamId   String
  team     Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  playerId String @unique
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  x        Float
  y        Float
}

// A country's league pyramid is instantiated one Season at a time. Season 1
// for a country is created (with bot teams filling every slot) the first
// time someone registers a team there - see src/lib/leagues/seed.ts.
model Season {
  id          String     @id @default(cuid())
  countryCode String
  number      Int
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  divisions   Division[]

  @@unique([countryCode, number])
}

// One table/group within a tier for a given season - e.g. tier 1 has a
// single division, tier 2 has two parallel divisions ("A"/"B").
model Division {
  id        String         @id @default(cuid())
  seasonId  String
  season    Season         @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  tier      Int
  group     String?
  name      String
  createdAt DateTime       @default(now())
  teams     DivisionTeam[]
  fixtures  Fixture[]

  @@unique([seasonId, tier, group])
}

model DivisionTeam {
  id         String   @id @default(cuid())
  divisionId String
  division   Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  teamId     String
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  joinedAt   DateTime @default(now())

  @@unique([divisionId, teamId])
}

model Fixture {
  id          String       @id @default(cuid())
  divisionId  String
  division    Division     @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  matchday    Int
  homeTeamId  String
  homeTeam    Team         @relation("HomeFixtures", fields: [homeTeamId], references: [id], onDelete: Cascade)
  awayTeamId  String
  awayTeam    Team         @relation("AwayFixtures", fields: [awayTeamId], references: [id], onDelete: Cascade)
  homeScore   Int?
  awayScore   Int?
  scheduledAt DateTime?
  playedAt    DateTime?
  createdAt   DateTime     @default(now())
  events      MatchEvent[]
}

// A single goal within a fixture's simulated 90 minutes - computed all at
// once the first time anyone views the match after kickoff (see
// src/lib/match/simulate.ts), then revealed progressively on the live match
// page based on elapsed real time.
model MatchEvent {
  id        String   @id @default(cuid())
  fixtureId String
  fixture   Fixture  @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  minute    Int
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  type      String   @default("goal")
  createdAt DateTime @default(now())
}

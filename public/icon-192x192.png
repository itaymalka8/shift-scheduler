  <rect x="115" y="82" width="15" height="11" rx="2" fill="#3b82f6"/>
  
  <rect x="55" y="101" width="15" height="11" rx="2" fill="#8b5cf6"/>
  <rect x="75" y="101" width="15" height="11" rx="2" fill="#8b5cf6"/>
  <rect x="95" y="101" width="15" height="11" rx="2" fill="#8b5cf6"/>
  <rect x="115" y="101" width="15" height="11" rx="2" fill="#8b5cf6"/>
  
  <rect x="55" y="120" width="15" height="11" rx="2" fill="#10b981"/>
  <rect x="75" y="120" width="15" height="11" rx="2" fill="#10b981"/>
  <rect x="95" y="120" width="15" height="11" rx="2" fill="#10b981"/>
  <rect x="115" y="120" width="15" height="11" rx="2" fill="#10b981"/>
  
  <!-- Hebrew Text -->
  <text x="96" y="68" font-family="Arial, sans-serif" font-size="9" font-weight="bold" text-anchor="middle" fill="white">משמרות</text>
  
  <!-- Decorative Elements -->
  <circle cx="37" cy="37" r="8" fill="white" opacity="0.3"/>
  <circle cx="155" cy="37" r="6" fill="white" opacity="0.3"/>

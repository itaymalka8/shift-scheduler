# A Postgres connection string - e.g. from a free Neon project
# (https://neon.tech). SQLite is no longer used: on Render's free tier the
# app's disk is wiped on every redeploy (and possibly on cold starts), which
# silently deleted every registered account - see render.yaml for details.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Optional: Google sign-in. Leave unset to hide the Google button.
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: Apple sign-in. Leave unset to hide the Apple button.
# Requires a paid Apple Developer Program account. APPLE_CLIENT_ID is your
# Services ID; APPLE_CLIENT_SECRET is a JWT you generate from your Sign in
# with Apple private key (it expires and must be regenerated periodically).
# Return URL: <NEXTAUTH_URL>/api/auth/callback/apple
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Optional. Only needed if you trigger fixture processing over HTTP (POST
# /api/internal/process-fixtures with an `Authorization: Bearer <this>`
# header) instead of the direct-script Render Cron Job in render.yaml. If
# unset, that route refuses every request rather than allowing them through -
# leave it unset unless you're actually using the HTTP path.
# Generate one with: openssl rand -base64 32
INTERNAL_JOB_SECRET=""
